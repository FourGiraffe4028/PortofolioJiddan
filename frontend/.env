# Kosong = pakai domain yang sama (Vercel). API dipanggil di /api pada host yang sama.
# Isi HANYA jika backend beda domain, mis: https://api.domainmu.com
REACT_APP_BACKEND_URL=

# Build di CI (Vercel set CI=true) memperlakukan warning sebagai error.
# Dua baris ini mencegah build gagal gara-gara lint warning & mempercepat build.
DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false
CI=false
